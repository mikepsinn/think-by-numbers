    line-height: 1.5;
  }
  .home-obj-title { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--home-soft); margin: 0 0 0.9rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--home-rule); display: flex; justify-content: space-between; gap: 1rem; }
  .home-obj-title span { font-weight: 400; letter-spacing: 0.06em; text-transform: none; }
  .home-objective dl { display: grid; grid-template-columns: auto 1fr; gap: 0.55rem 1.1rem; margin: 0; }
  .home-objective dt { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.72rem; color: var(--home-soft); padding-top: 0.15rem; }
  .home-objective dd { margin: 0; font-weight: 700; }
  .home-objective .op { font-weight: 400; color: var(--home-soft); padding: 0 0.15rem; }
