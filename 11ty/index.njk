---
layout: base.njk
permalink: /
title: "Think by Numbers"
description: "Earth as it is and as it could be, in numbers: healthy life expectancy, income, cures per year, the cost of a trial, and the loop that moves them."
eleventyExcludeFromCollections: true
---
{%- set mp = manualParams %}
<style>
  .home {
    --home-paper: var(--color-bg);
    --home-paper-2: var(--color-paper);
    --home-ink: var(--color-text);
    --home-soft: var(--color-text-light);
    --home-rule: #dedede;
    --home-blue: #1f4079;
    --home-blue-line: #f6f4ee;
    --home-blue-soft: rgba(246, 244, 238, 0.72);
    --home-blue-rule: rgba(246, 244, 238, 0.3);
    --home-blue-grid: rgba(255, 255, 255, 0.07);
    --home-mono: 'Courier Prime', 'Courier New', Courier, monospace;
    --home-serif: 'Crimson Text', 'Baskerville', 'Georgia', serif;
    color: var(--home-ink);
    background: var(--home-paper);
    line-height: 1.5;
  }
  [data-theme="dark"] .home { --home-rule: #333333; }
  .home .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .home h1, .home h2 { margin: 0; text-wrap: balance; line-height: 1.12; }
  .home p { margin: 0; }
  .home a { color: var(--home-ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--home-soft); }
  .home a:hover { text-decoration-color: var(--home-ink); }
  .home :focus-visible { outline: 2px solid var(--home-ink); outline-offset: 3px; }
  .home-wrap { max-width: 1000px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px); }
  .home-sec { padding-top: 4rem; }
  .home h2 { font-size: 1.35rem; font-weight: 400; font-style: italic; color: var(--home-soft); margin-bottom: 1.4rem; }

  /* Tagline and objective */
  .home-top { padding-top: 3.5rem; text-align: center; }
  .home-top h1 {
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.4rem, 5.6vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    max-width: 18ch;
    margin: 0 auto 1.4rem;
  }
  .home .home-objective { font-size: 1.12rem; max-width: 52ch; margin: 0 auto; color: var(--home-ink); }

  /* The bill */
  .home-bill { text-align: center; padding-top: 3.25rem; }
  .home-bill-figure {
    display: inline-block;
    font-size: clamp(3.2rem, 8vw, 5.6rem);
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .home-bill-figure:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .home .home-bill-label { margin-top: 0.8rem; font-size: 1.05rem; color: var(--home-soft); }

  /* The readout */
  .home-ledger { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
  .home-ledger th, .home-ledger td { text-align: left; vertical-align: baseline; padding: 1.1rem 1.25rem 1.1rem 0; border-top: 1px solid var(--home-rule); }
  .home-ledger thead th { border-top: 0; padding-top: 0; padding-bottom: 0.5rem; font-weight: 400; font-style: italic; font-size: 0.95rem; color: var(--home-soft); }
  .home-ledger tbody tr:last-child th, .home-ledger tbody tr:last-child td { border-bottom: 1px solid var(--home-rule); }
  .home-ledger th[scope="row"] { font-weight: 400; font-size: 1.05rem; width: 30%; max-width: 24ch; }
  .home-ledger .num { font-size: 1.9rem; line-height: 1.1; font-variant-numeric: lining-nums tabular-nums; white-space: nowrap; width: 24%; }
  .home-ledger .num a { text-decoration: none; }
  .home-ledger .num a:hover { text-decoration: underline; }
  .home-ledger .could { font-weight: 600; }
  .home-ledger .when { display: block; font-size: 0.78rem; font-weight: 400; color: var(--home-soft); margin-top: 0.15rem; white-space: nowrap; }
  .home-ledger .moved { font-size: 0.95rem; font-style: italic; color: var(--home-soft); padding-right: 0; }
  .home-ledger .moved a { color: var(--home-soft); }
  .home-ledger .moved a:hover { color: var(--home-ink); }
  .home-ledger .word { font-size: 1.25rem; white-space: normal; }

  /* Diagrams */
  .home-figure { margin: 0 0 1.75rem; }
  .home-figure-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .home-figure svg { display: block; width: 100%; max-width: 820px; min-width: 620px; height: auto; margin: 0 auto; }
  .home-figure figcaption { font-size: 0.92rem; color: var(--home-soft); margin: 0.5rem auto 0; max-width: 820px; }
  .home-diagram .box { fill: var(--home-paper-2); stroke: var(--home-ink); stroke-width: 1.4; }
  .home-diagram .box-missing { fill: none; stroke: var(--home-soft); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .home-diagram .wire { fill: none; stroke: var(--home-ink); stroke-width: 1.4; }
  .home-diagram .wire-missing { fill: none; stroke: var(--home-soft); stroke-width: 1.2; stroke-dasharray: 4 5; }
  .home-diagram .t { font-family: var(--home-serif); font-size: 15px; fill: var(--home-ink); }
  .home-diagram .t-sub { font-family: var(--home-mono); font-size: 10px; fill: var(--home-soft); letter-spacing: 0.04em; }
  .home-diagram .t-side { font-family: var(--home-serif); font-style: italic; font-size: 16px; fill: var(--home-ink); }
  .home-diagram .t-note { font-family: var(--home-mono); font-size: 11px; fill: var(--home-soft); letter-spacing: 0.06em; }

  /* The world that could be */
  .home-blue {
    margin-top: 4rem;
    background-color: var(--home-blue);
    background-image:
      linear-gradient(var(--home-blue-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--home-blue-grid) 1px, transparent 1px);
    background-size: 24px 24px;
    color: var(--home-blue-line);
    padding: 3rem 0 3rem;
  }
  .home-blue h2 { color: var(--home-blue-soft); }
  .home-blue a { color: var(--home-blue-line); text-decoration-color: var(--home-blue-rule); }
  .home-charts { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 3rem; }
  .home-chart { margin: 0; }
  .home-chart svg { display: block; width: 100%; height: auto; }
  .home-chart .axis { stroke: var(--home-blue-rule); stroke-width: 1; }
  .home-chart .grid { stroke: var(--home-blue-rule); stroke-width: 0.6; stroke-dasharray: 2 4; }
  .home-chart .tick { font-family: var(--home-serif); font-size: 10.5px; fill: var(--home-blue-soft); }
  .home-chart .title { font-family: var(--home-serif); font-style: italic; font-size: 14px; fill: var(--home-blue-line); }
  .home-chart .line { fill: none; stroke: var(--home-blue-line); stroke-linecap: round; stroke-linejoin: round; }
  .home-chart .line-baseline { stroke-width: 1.3; stroke-dasharray: 2 4; stroke: var(--home-blue-soft); }
  .home-chart .line-treaty { stroke-width: 1.8; }
  .home-chart .line-wishonia { stroke-width: 2.8; }
  .home-chart .end { font-family: var(--home-serif); font-size: 11px; fill: var(--home-blue-line); }
  .home-chart .end-baseline { fill: var(--home-blue-soft); }
  .home .home-source { margin-top: 1.5rem; font-size: 0.92rem; color: var(--home-blue-soft); }

  /* Papers */
  .home-papers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem 1.5rem; }
  .home-paper { border: 1px solid var(--home-rule); background: var(--home-paper-2); display: flex; flex-direction: column; }
  .home-paper img { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; border-bottom: 1px solid var(--home-rule); }
  .home-paper-name { font-size: 1.15rem; line-height: 1.3; margin: 0.9rem 1rem 0.3rem; }
  .home-paper-name a { text-decoration: none; }
  .home-paper-name a:hover { text-decoration: underline; }
  .home-paper-title { font-size: 0.92rem; line-height: 1.45; color: var(--home-soft); margin: 0 1rem 1rem; }
  .home-end { padding-bottom: 1.5rem; }

  @media (max-width: 1024px) {
    .home-papers { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .home-charts { grid-template-columns: 1fr; }
    .home-papers { grid-template-columns: 1fr; }
    .home-ledger thead { display: none; }
    .home-ledger, .home-ledger tbody { display: block; }
    .home-ledger tr { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem 1rem; padding: 1rem 0; border-top: 1px solid var(--home-rule); }
    .home-ledger tbody tr:last-child { border-bottom: 1px solid var(--home-rule); }
    .home-ledger th, .home-ledger td { display: block; border: 0; padding: 0; width: auto; max-width: none; }
    .home-ledger th[scope="row"] { grid-column: 1 / -1; width: auto; max-width: none; }
    .home-ledger .num { font-size: 1.5rem; white-space: normal; }
    .home-ledger .num::before { display: block; font-size: 0.8rem; font-style: italic; color: var(--home-soft); content: attr(data-col); margin-bottom: 0.1rem; }
    .home-ledger .moved { grid-column: 1 / -1; margin-top: 0.35rem; }
  }
</style>

<div class="home" data-pagefind-ignore>

  <section class="home-wrap home-top">
    <h1>{{ site.description }}.</h1>
    <p class="home-objective"><a href="https://manual.warondisease.org/knowledge/solution/optimocracy.html">Objective</a>: the median person's healthy years and income after tax. In the long run, pleasant consciousness in the universe.</p>
  </section>

  <section class="home-wrap home-bill" aria-label="The bill">
    <a class="home-bill-figure" href="{{ mp.POLITICAL_DYSFUNCTION_TAX_PER_PERSON_ANNUAL.url }}">{{ mp.POLITICAL_DYSFUNCTION_TAX_PER_PERSON_ANNUAL.formatted }}</a>
    <p class="home-bill-label">The cost of suboptimal governance, per person, per year. <a href="{{ mp.POLITICAL_DYSFUNCTION_TAX_PER_HOUSEHOLD_OF_FOUR_ANNUAL.url }}">{{ mp.POLITICAL_DYSFUNCTION_TAX_PER_HOUSEHOLD_OF_FOUR_ANNUAL.formatted }}</a> per household of four.</p>
  </section>

  <section class="home-wrap home-sec" aria-label="Earth today and as it could be">
    <table class="home-ledger">
      <thead>
        <tr>
          <th scope="col"><span class="visually-hidden">Measure</span></th>
          <th scope="col">Today</th>
          <th scope="col">Could be</th>
          <th scope="col">Moved by</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Healthy life expectancy</th>
          <td class="num" data-col="Today"><a href="{{ mp.GLOBAL_HALE_CURRENT.url }}">{{ mp.GLOBAL_HALE_CURRENT.formatted }}</a></td>
          <td class="num could" data-col="Could be"><a href="{{ mp.WISHONIA_PROJECTED_HALE_YEAR_15.url }}">{{ mp.WISHONIA_PROJECTED_HALE_YEAR_15.formatted }}</a><small class="when">year 15</small></td>
          <td class="moved"><a href="https://dfda.earth/">Decentralized FDA</a></td>
        </tr>
        <tr>
          <th scope="row">Median income after tax, per year</th>
          <td class="num" data-col="Today"><a href="{{ mp.GLOBAL_MEDIAN_AFTER_TAX_INCOME_2025.url }}">{{ mp.GLOBAL_MEDIAN_AFTER_TAX_INCOME_2025.formatted }}</a></td>
          <td class="num could" data-col="Could be"><a href="{{ mp.WISHONIA_TRAJECTORY_MEDIAN_AFTER_TAX_INCOME_YEAR_20.url }}">{{ mp.WISHONIA_TRAJECTORY_MEDIAN_AFTER_TAX_INCOME_YEAR_20.formatted }}</a><small class="when">year 20</small></td>
          <td class="moved"><a href="https://warondisease.org/">The 1% Treaty</a></td>
        </tr>
        <tr>
          <th scope="row">Diseases getting their first effective treatment, per year</th>
          <td class="num" data-col="Today"><a href="{{ mp.NEW_DISEASE_FIRST_TREATMENTS_PER_YEAR.url }}">{{ mp.NEW_DISEASE_FIRST_TREATMENTS_PER_YEAR.short }}</a></td>
          <td class="num could" data-col="Could be"><a href="{{ mp.DFDA_FIRST_TREATMENTS_PER_YEAR.url }}">{{ mp.DFDA_FIRST_TREATMENTS_PER_YEAR.short }}</a><small class="when">with 1% moved</small></td>
          <td class="moved"><a href="https://dfda.earth/">Decentralized FDA</a></td>
        </tr>
        <tr>
          <th scope="row">Years to test every treatment in the queue</th>
          <td class="num" data-col="Today"><a href="{{ mp.STATUS_QUO_QUEUE_CLEARANCE_YEARS.url }}">{{ mp.STATUS_QUO_QUEUE_CLEARANCE_YEARS.value | round }}</a></td>
          <td class="num could" data-col="Could be"><a href="{{ mp.DFDA_QUEUE_CLEARANCE_YEARS.url }}">{{ mp.DFDA_QUEUE_CLEARANCE_YEARS.value | round }}</a><small class="when">with 1% moved</small></td>
          <td class="moved"><a href="https://dfda.earth/">Decentralized FDA</a></td>
        </tr>
        <tr>
          <th scope="row">Cost of a clinical trial, per patient</th>
          <td class="num" data-col="Today"><a href="{{ mp.TRADITIONAL_PHASE3_COST_PER_PATIENT.url }}">{{ mp.TRADITIONAL_PHASE3_COST_PER_PATIENT.formatted }}</a></td>
          <td class="num could" data-col="Could be"><a href="{{ mp.RECOVERY_TRIAL_COST_PER_PATIENT.url }}">{{ mp.RECOVERY_TRIAL_COST_PER_PATIENT.formatted }}</a><small class="when">demonstrated</small></td>
          <td class="moved"><a href="https://dfda.earth/">Decentralized FDA</a></td>
        </tr>
        <tr>
          <th scope="row">Government spending on trials of cures, per year</th>
          <td class="num" data-col="Today"><a href="{{ mp.GLOBAL_GOVERNMENT_CLINICAL_TRIALS_SPENDING_ANNUAL.url }}">{{ mp.GLOBAL_GOVERNMENT_CLINICAL_TRIALS_SPENDING_ANNUAL.formatted }}</a></td>
          <td class="num could" data-col="Could be"><a href="{{ mp.TRIAL_FUNDING_WITH_TREATY.url }}">{{ mp.TRIAL_FUNDING_WITH_TREATY.formatted }}</a><small class="when">with 1% moved</small></td>
          <td class="moved"><a href="https://warondisease.org/">The 1% Treaty</a></td>
        </tr>
        <tr>
          <th scope="row">Whether a policy's results are measured</th>
          <td class="num word" data-col="Today">No</td>
          <td class="num could word" data-col="Could be">Yes</td>
          <td class="moved"><a href="https://optimitron.com/">Optimitron</a></td>
        </tr>
        <tr>
          <th scope="row">Who sets the budget</th>
          <td class="num word" data-col="Today">Lobbyists</td>
          <td class="num could word" data-col="Could be">Everyone, two options at a time</td>
          <td class="moved"><a href="https://wishocracy.warondisease.org/">Wishocracy</a></td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="home-wrap home-sec" aria-label="The loop">
    <h2>The loop</h2>

    <figure class="home-figure">
      <div class="home-figure-scroll">
        <svg class="home-diagram" viewBox="0 0 780 300" role="img" aria-labelledby="loops-title">
          <title id="loops-title">Two diagrams. An oven: set the temperature, heat, check with a thermometer, adjust. A government: announce a policy, spend the budget, outcomes, no sensor, no comparison, no adjustment.</title>
          <defs>
            <marker id="arrow-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="var(--color-text)"/></marker>
            <marker id="arrow-soft" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="var(--color-text-light)"/></marker>
          </defs>

          <text class="t-side" x="20" y="34">An oven</text>
          <rect class="box" x="20" y="48" width="118" height="44" rx="2"/>
          <text class="t" x="79" y="75" text-anchor="middle">Set 180°</text>
          <path class="wire" d="M138 70 H176" marker-end="url(#arrow-ink)"/>
          <rect class="box" x="178" y="48" width="150" height="44" rx="2"/>
          <text class="t" x="253" y="75" text-anchor="middle">Heating element</text>
          <path class="wire" d="M328 70 H366" marker-end="url(#arrow-ink)"/>
          <rect class="box" x="368" y="48" width="104" height="44" rx="2"/>
          <text class="t" x="420" y="75" text-anchor="middle">Oven</text>
          <path class="wire" d="M472 70 H510" marker-end="url(#arrow-ink)"/>
          <rect class="box" x="512" y="48" width="104" height="44" rx="2"/>
          <text class="t" x="564" y="75" text-anchor="middle">Dinner</text>
          <path class="wire" d="M420 92 V124 H79 V96" marker-end="url(#arrow-ink)"/>
          <text class="t-note" x="250" y="141" text-anchor="middle">THERMOMETER: MEASURES, COMPARES TO THE SETTING, ADJUSTS</text>

          <text class="t-side" x="20" y="196">A government</text>
          <rect class="box" x="20" y="210" width="150" height="44" rx="2"/>
          <text class="t" x="95" y="237" text-anchor="middle">Announce a policy</text>
          <path class="wire" d="M170 232 H208" marker-end="url(#arrow-ink)"/>
          <rect class="box" x="210" y="210" width="150" height="44" rx="2"/>
          <text class="t" x="285" y="237" text-anchor="middle">Spend the budget</text>
          <path class="wire" d="M360 232 H398" marker-end="url(#arrow-ink)"/>
          <rect class="box" x="400" y="210" width="120" height="44" rx="2"/>
          <text class="t" x="460" y="237" text-anchor="middle">Outcomes</text>
          <path class="wire-missing" d="M520 232 H558" marker-end="url(#arrow-soft)"/>
          <rect class="box-missing" x="560" y="210" width="56" height="44" rx="2"/>
          <text class="t" x="588" y="238" text-anchor="middle" fill="var(--color-text-light)">?</text>
          <path class="wire-missing" d="M460 254 V286 H330"/>
          <text class="t-note" x="326" y="290" text-anchor="end">NO SENSOR · NO COMPARISON · NO ADJUSTMENT</text>
        </svg>
      </div>
    </figure>

    <figure class="home-figure">
      <div class="home-figure-scroll">
        <svg class="home-diagram" viewBox="0 0 780 250" role="img" aria-labelledby="loop2-title">
          <title id="loop2-title">The loop being built: the goal, the budget, the policy, outcomes, and a sensor feeding back to the goal.</title>
          <rect class="box" x="20" y="40" width="162" height="62" rx="2"/>
          <text class="t" x="101" y="64" text-anchor="middle">The goal</text>
          <text class="t-sub" x="101" y="80" text-anchor="middle">MEDIAN HEALTHY YEARS</text>
          <text class="t-sub" x="101" y="93" text-anchor="middle">MEDIAN INCOME AFTER TAX</text>
          <path class="wire" d="M182 71 H218" marker-end="url(#arrow-ink)"/>
          <rect class="box" x="220" y="40" width="152" height="62" rx="2"/>
          <text class="t" x="296" y="64" text-anchor="middle">The budget</text>
          <text class="t-sub" x="296" y="80" text-anchor="middle">WISHOCRACY</text>
          <text class="t-sub" x="296" y="93" text-anchor="middle">THE 1% TREATY</text>
          <path class="wire" d="M372 71 H408" marker-end="url(#arrow-ink)"/>
          <rect class="box" x="410" y="40" width="154" height="62" rx="2"/>
          <text class="t" x="487" y="64" text-anchor="middle">The policy</text>
          <text class="t-sub" x="487" y="80" text-anchor="middle">WHATEVER THE</text>
          <text class="t-sub" x="487" y="93" text-anchor="middle">EVIDENCE SUPPORTS</text>
          <path class="wire" d="M564 71 H604" marker-end="url(#arrow-ink)"/>
          <rect class="box" x="606" y="40" width="154" height="62" rx="2"/>
          <text class="t" x="683" y="64" text-anchor="middle">Outcomes</text>
          <text class="t-sub" x="683" y="80" text-anchor="middle">WHAT HAPPENS</text>
          <text class="t-sub" x="683" y="93" text-anchor="middle">TO PEOPLE</text>
          <path class="wire" d="M683 102 V170 H612" marker-end="url(#arrow-ink)"/>
          <rect class="box" x="270" y="140" width="340" height="62" rx="2"/>
          <text class="t" x="440" y="164" text-anchor="middle">The sensor</text>
          <text class="t-sub" x="440" y="180" text-anchor="middle">DECENTRALIZED FDA · TRIALS AT ${{ mp.RECOVERY_TRIAL_COST_PER_PATIENT.value | round }} A PATIENT</text>
          <text class="t-sub" x="440" y="193" text-anchor="middle">OPTIMITRON · WHICH POLICIES ACTUALLY WORK</text>
          <path class="wire" d="M270 170 H101 V106" marker-end="url(#arrow-ink)"/>
          <text class="t-note" x="186" y="188" text-anchor="middle" style="font-size:10px">MEASURE, COMPARE, ADJUST</text>
        </svg>
      </div>
      <figcaption>The same loop, with the parts that exist so far.</figcaption>
    </figure>
  </section>

  <section class="home-blue" aria-label="The world that could be">
    <div class="home-wrap">
      <h2>The world that could be</h2>
      <div class="home-charts">
        {%- for panel in futures.panels %}
        <figure class="home-chart">
          <svg viewBox="0 0 {{ panel.width }} {{ panel.height }}" role="img" aria-label="{{ panel.title }}: {% for s in panel.series %}{{ s.label }}{% if not loop.last %}; {% endif %}{% endfor %}">
            <text class="title" x="{{ panel.axis.x0 }}" y="11">{{ panel.title }}</text>
            {%- for tick in panel.ticks %}
            <line class="grid" x1="{{ panel.axis.x0 }}" x2="{{ panel.axis.x1 }}" y1="{{ tick.y | round(1) }}" y2="{{ tick.y | round(1) }}"/>
            <text class="tick" x="{{ panel.axis.x0 - 6 }}" y="{{ (tick.y + 3) | round(1) }}" text-anchor="end">{{ tick.label }}</text>
            {%- endfor %}
            <line class="axis" x1="{{ panel.axis.x0 }}" x2="{{ panel.axis.x1 }}" y1="{{ panel.axis.y0 | round(1) }}" y2="{{ panel.axis.y0 | round(1) }}"/>
            {%- for yr in panel.years %}
            <text class="tick" x="{{ yr.x | round(1) }}" y="{{ (panel.axis.y0 + 16) | round(1) }}" text-anchor="{% if loop.first %}start{% else %}middle{% endif %}">{{ yr.label }}</text>
            {%- endfor %}
            {%- for s in panel.series %}
            <polyline class="line line-{{ s.kind }}" points="{{ s.points }}"/>
            <text class="end end-{{ s.kind }}" x="{{ (s.end.x + 7) | round(1) }}" y="{{ (s.end.y + 3.5) | round(1) }}">{{ s.label }}</text>
            {%- endfor %}
          </svg>
        </figure>
        {%- endfor %}
      </div>
      <p class="home-source">From the <a href="{{ futures.source }}">trajectory models</a>. Income is on a log scale.</p>
    </div>
  </section>

  <section class="home-wrap home-sec home-end" aria-label="Papers">
    <h2>Papers</h2>
    <div class="home-papers">
      {%- for paper in papers %}
      <div class="home-paper">
        <a href="{{ paper.url }}"><img src="{{ paper.image }}" alt="" width="1200" height="630"{% if loop.index0 > 2 %} loading="lazy"{% endif %}></a>
        <p class="home-paper-name"><a href="{{ paper.url }}">{{ paper.name }}</a></p>
        <p class="home-paper-title">{{ paper.title }}</p>
      </div>
      {%- endfor %}
    </div>
  </section>

</div>
