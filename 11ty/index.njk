    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .home a.home-btn:hover { background: var(--home-paper); color: var(--home-ink); }
  .home a.home-btn-ghost { background: transparent; color: var(--home-ink); }
  .home a.home-btn-ghost:hover { background: var(--home-ink); color: var(--home-paper); }
  .home a.home-quiet { font-style: italic; color: var(--home-soft); }

  /* Hero */
  .home-hero { padding: 3rem 0 2.75rem; }
  .home-hero h1 {
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 4.4rem);
    line-height: 1.06;
    letter-spacing: -0.01em;
    max-width: 17ch;
    margin: 0 0 2rem;
  }
  .home-hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, 1fr); gap: 2.5rem 4rem; align-items: start; }
  .home-lead p { max-width: 60ch; font-size: 1.14rem; }
  .home-objective {
    border: 1px solid var(--home-rule-strong);
    background: var(--home-paper-2);
    padding: 1.2rem 1.35rem 1.1rem;
    font-family: var(--home-mono);
