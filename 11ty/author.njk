---
layout: base.njk
title: "Posts by Mike P. Sinn"
permalink: "/author/mikepsinn/"
---

<style>
  .author-card {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 30px;
    margin-bottom: 40px;
    padding: 30px;
    border: 2px solid var(--color-text);
    background: var(--color-paper);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--color-text);
  }

  .author-avatar img {
    display: block;
    width: 128px;
    height: 128px;
    border: 2px solid var(--color-text);
    border-radius: 50%;
    object-fit: cover;
  }

  .author-info h1 {
    margin: 0 0 12px;
  }

  .author-info p {
    margin: 10px 0;
    font-size: 1.05em;
    line-height: 1.6;
  }

  .author-expertise {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--color-text-light);
  }

  .author-expertise-label {
    font-size: 0.85em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .author-expertise-list,
  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .author-skill {
    display: inline-flex;
    padding: 5px 10px;
    border: 1px solid var(--color-text-light);
    background: var(--color-bg);
    font-size: 0.85em;
  }

  .author-link,
  .author-archive-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 13px;
    border: 2px solid var(--color-text);
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    box-shadow: 3px 3px 0 var(--color-text);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .author-link:hover,
  .author-archive-link:hover {
    color: var(--color-text);
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--color-text);
  }

  .author-posts-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }

  .author-posts-header h2 {
    margin-bottom: 0;
  }

  .author-post-count {
    color: var(--color-text-light);
    white-space: nowrap;
  }

  .author-archive-actions {
    margin-top: 32px;
    text-align: center;
  }

  @media (max-width: 640px) {
    .author-card {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 22px 18px;
      text-align: center;
    }

    .author-avatar img {
      width: 96px;
      height: 96px;
      margin: 0 auto;
    }

    .author-info p {
      text-align: left;
    }

    .author-expertise-list,
    .author-links {
      justify-content: center;
    }

    .author-link {
      flex: 1 1 130px;
    }

    .author-posts-header {
      display: block;
    }
  }
</style>

<div class="container" data-pagefind-ignore>
  <div class="main-content">
    <section class="author-card" aria-labelledby="author-name">
      <div class="author-avatar">
        <img src="{{ site.author.avatar }}"
             alt="{{ site.author.name }}"
             width="128"
             height="128">
      </div>
      <div class="author-info">
        <h1 id="author-name">{{ site.author.name }}</h1>

        <p>
          {{ site.author.bio }}
        </p>

        <p>
          {{ site.author.bioExtended }}
        </p>

        <p>
          {{ site.author.mission }}
        </p>

        <div class="author-expertise">
          <strong class="author-expertise-label">Expertise</strong>
          <div class="author-expertise-list">
            {% for skill in site.author.expertise %}
              <span class="author-skill">{{ skill }}</span>
            {% endfor %}
          </div>
        </div>

        <div class="author-links" aria-label="Mike Sinn on other websites">
          <a class="author-link" href="{{ site.author.url }}" target="_blank" rel="noopener noreferrer">
            <i class="fa-solid fa-globe"></i> Website
          </a>
          <a class="author-link" href="{{ site.social.linkedin }}" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-linkedin"></i> LinkedIn
          </a>
          <a class="author-link" href="{{ site.social.github }}" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-github"></i> GitHub
          </a>
          <a class="author-link" href="{{ site.social.twitter }}" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-x-twitter"></i> X
          </a>
        </div>
      </div>
    </section>

    {%- set authorPosts = collections.posts %}
    <div class="author-posts-header">
      <h2>Latest posts by {{ site.author.name }}</h2>
      <p class="author-post-count">Showing 12 of {{ authorPosts.length }}</p>
    </div>

    <div class="post-grid">
      {%- for post in authorPosts %}
      {%- if loop.index <= 12 %}
      <article class="post-card">
        {%- if post.data.metadata.media.featuredImage %}
        <div class="post-image">
          <a href="{{ post.url }}">
            <img src="{{ post.data.metadata.media.featuredImage }}" alt="{{ post.data.title | decodeHtml }}">
          </a>
        </div>
        {%- endif %}

        <div class="post-header">
          <h3 class="post-title">
            <a href="{{ post.url }}">{{ post.data.title | decodeHtml }}</a>
          </h3>
        </div>

        <div class="post-info">
          <time datetime="{{ post.date | dateToISO }}">{{ post.date | readableDate }}</time>
          <div class="entry-summary">
            <p>{{ post.templateContent | excerpt | safe }}</p>
          </div>
        </div>

        <div class="post-footer">
          <small>
            <a href="{{ post.url }}">
              <span class="read-more">Read more</span>
            </a>
          </small>
        </div>
      </article>
      {%- endif %}
      {%- endfor %}
    </div>

    <div class="author-archive-actions">
      <a class="author-archive-link" href="/search/">
        <i class="fa-solid fa-magnifying-glass"></i> Search all {{ authorPosts.length }} posts
      </a>
    </div>
  </div>

  <aside class="sidebar">
    <div class="widget">
      <h4>Search</h4>
      <form action="/search/" method="get">
        <input type="text" name="q" placeholder="Search posts..." required>
        <button type="submit">🔍 Search</button>
      </form>
    </div>

    <div class="widget">
      <h4>Follow Us</h4>
      <ul class="social-links">
        <li><a href="{{ site.social.facebook }}" target="_blank">Facebook</a></li>
        <li><a href="{{ site.social.twitter }}" target="_blank">Twitter</a></li>
        <li><a href="{{ site.social.linkedin }}" target="_blank">LinkedIn</a></li>
      </ul>
    </div>
  </aside>
</div>
