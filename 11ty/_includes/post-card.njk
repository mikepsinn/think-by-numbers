{#
  Reusable post card component
  Usage: {% include "post-card.njk" %}
  Expects: post variable in context
#}
{%- set media = post.data.metadata.media if post.data.metadata else none %}
{%- set imageUrl = (media.card if media else none) or (media.ogImage if media else none) or (media.infographic if media else none) or (media.featuredImage if media else none) %}
<article class="post-card">
  {%- if imageUrl %}
  {%- set eager = loop and loop.index0 < 2 %}
  <div class="post-image">
    <a href="{{ post.url }}"{% if post.data.external %} target="_blank" rel="noopener"{% endif %}>
      <img src="{{ imageUrl }}" alt="{{ post.data.title | safe }}" width="720" height="400" decoding="async"{% if eager %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
    </a>
  </div>
  {%- endif %}

  <div class="post-header">
    <h3 class="post-title">
      <a href="{{ post.url }}"{% if post.data.external %} target="_blank" rel="noopener"{% endif %}>{{ post.data.title | safe }}</a>
    </h3>
  </div>

  <div class="post-info">
    <div class="entry-summary">
      {%- if post.data.description %}
      <p>{{ post.data.description }}</p>
      {%- elif post.data.metadata and post.data.metadata.summary %}
      <p>{{ post.data.metadata.summary }}</p>
      {%- elif post.templateContent %}
      <p>{{ post.templateContent | excerpt | safe }}</p>
      {%- endif %}
    </div>
  </div>

  <div class="post-footer">
    <small>
      <a href="{{ post.url }}"{% if post.data.external %} target="_blank" rel="noopener"{% endif %}>
        <span class="read-more">Read more</span>
      </a>
    </small>
    {%- if post.data.aiScores and post.data.aiScores.composite %}
    <small class="post-score">{{ post.data.aiScores.composite }}/10</small>
    {%- endif %}
  </div>
</article>
