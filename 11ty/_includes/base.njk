<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title and site.name in title %}{{ title | safe }}{% elif title %}{{ title | safe }} - {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or (content | excerpt) or site.description }}">
  <meta name="author" content="{{ site.author.name }}">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#000000">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {# Favicon #}
  <link rel="icon" type="image/png" sizes="32x32" href="/wp-content/uploads/2016/10/cropped-Think-By-Numbers-tbn-logo-favicon-icon-Thumbnail-600-x-600-transparent-32x32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/wp-content/uploads/2016/10/cropped-Think-By-Numbers-tbn-logo-favicon-icon-Thumbnail-600-x-600-transparent-192x192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/wp-content/uploads/2016/10/cropped-Think-By-Numbers-tbn-logo-favicon-icon-Thumbnail-600-x-600-transparent-180x180.png">

  {# Open Graph / Facebook #}
  <meta property="og:locale" content="en_US">
  <meta property="og:type" content="{% if title and date %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if title %}{{ title | safe }}{% else %}{{ site.name }}{% endif %}">
  <meta property="og:description" content="{{ description or (content | excerpt) or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:image" content="{{ site.url }}{% if metadata.media.ogImage %}{{ metadata.media.ogImage }}{% elif metadata.media.featuredImage %}{{ metadata.media.featuredImage }}{% else %}/wp-content/uploads/2025/12/think-by-numbers-og.png{% endif %}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  {# Article-specific Open Graph tags #}
  {% if title and date %}
  <meta property="article:published_time" content="{{ date | dateToISO }}">
  {% if page.inputPath and page.inputPath.includes('/content/') %}
  <meta property="article:modified_time" content="{{ page.date | dateToISO }}">
  {% endif %}
  <meta property="article:author" content="{{ site.url }}/author/mikepsinn/">
  {% if metadata.categories %}
  <meta property="article:section" content="{{ metadata.categories[0] }}">
  {% endif %}
  {% if tags %}
  {% for tag in tags %}
  <meta property="article:tag" content="{{ tag }}">
  {% endfor %}
  {% endif %}
  {% endif %}

  {# Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="{{ site.social.twitterHandle }}">
  <meta name="twitter:creator" content="{{ site.social.twitterHandle }}">
  <meta name="twitter:title" content="{% if title %}{{ title | safe }}{% else %}{{ site.name }}{% endif %}">
  <meta name="twitter:description" content="{{ description or (content | excerpt) or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}{% if metadata.media.ogImage %}{{ metadata.media.ogImage }}{% elif metadata.media.featuredImage %}{{ metadata.media.featuredImage }}{% else %}/wp-content/uploads/2025/12/think-by-numbers-twitter.png{% endif %}">

  {# Schema.org structured data #}
  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "WebSite",
    "url": "{{ site.url }}",
    "name": "{{ site.name }}",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "{{ site.url }}/search/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Person",
    "url": "{{ site.url }}/author/mikepsinn/",
    "sameAs": [
      "{{ site.author.url }}",
      "{{ site.social.facebook }}",
      "{{ site.social.linkedin }}",
      "{{ site.social.youtube }}",
      "{{ site.social.twitter }}"
    ],
    "name": "{{ site.author.name }}"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.url }}{{ site.logo }}"
    },
    "sameAs": [
      "{{ site.social.facebook }}",
      "{{ site.social.linkedin }}",
      "{{ site.social.youtube }}",
      "{{ site.social.twitter }}"
    ]
  }
  </script>
  {%- if title and date %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ title | safe }}",
    "description": "{{ description or (content | excerpt) or site.description }}",
    "image": "{{ site.url }}{% if metadata.media.ogImage %}{{ metadata.media.ogImage }}{% elif metadata.media.featuredImage %}{{ metadata.media.featuredImage }}{% else %}/wp-content/uploads/2025/12/think-by-numbers-og.png{% endif %}",
    "author": {
      "@type": "Person",
      "name": "{{ site.author.name }}",
      "url": "{{ site.url }}/author/mikepsinn/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.name }}",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ site.url }}{{ site.logo }}"
      }
    },
    "datePublished": "{{ date | dateToISO }}",
    "dateModified": "{% if page.inputPath and page.inputPath.includes('/content/') %}{{ page.date | dateToISO }}{% else %}{{ date | dateToISO }}{% endif %}",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ site.url }}{{ page.url }}"
    }{% if tags %},
    "keywords": "{{ tags | join(', ') }}"{% endif %}
  }
  </script>
  {%- endif %}

  {# RSS Feeds #}
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} Feed" href="{{ site.feedPath }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} Podcast Feed" href="{{ site.podcastFeedPath }}">


  <style>
    /* Classic Black & White Design System */
    :root {
      --color-bg: #ffffff;
      --color-paper: #fafafa;
      --color-text: #000000;
      --color-text-light: #666666;
      --color-accent: #000000;
      --color-link: #000000;
      --color-link-hover: #333333;
      --border-subtle: 1px;
      --shadow-subtle: 2px;
    }

    /* Dark Mode Variables */
    [data-theme="dark"] {
      --color-bg: #000000;
      --color-paper: #0a0a0a;
      --color-text: #ffffff;
      --color-text-light: #999999;
      --color-accent: #ffffff;
      --color-link: #ffffff;
      --color-link-hover: #cccccc;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Crimson Text', 'Baskerville', 'Georgia', serif;
      line-height: 1.7;
      margin: 0;
      padding: 0;
      color: var(--color-text);
      background: var(--color-bg);
      font-weight: 400;
      font-size: 19px;
    }

    h1, h2, h3, h4, h5, h6 {
      font-weight: 700;
      line-height: 1.3;
      font-family: 'Crimson Text', 'Baskerville', 'Georgia', serif;
      color: var(--color-text);
    }

    /* Site header: one line, wordmark left, text navigation right */
    .site-header {
      border-bottom: var(--border-subtle) solid var(--color-text);
      background: var(--color-bg);
    }

    .site-header-in {
      max-width: 1200px;
      margin: 0 auto;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px 32px;
    }

    .site-brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--color-text);
      font-size: 1.35em;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.01em;
    }

    .site-brand em {
      font-weight: 400;
      font-style: italic;
      font-size: 0.85em;
    }

    .site-mark {
      width: 34px;
      height: 34px;
      flex: none;
    }

    .site-nav {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px 22px;
      font-family: 'Courier Prime', 'Courier New', Courier, monospace;
      font-size: 0.74em;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .site-nav a {
      color: var(--color-text-light);
      text-decoration: none;
      padding: 4px 0;
      border-bottom: 1px solid transparent;
      transition: color 0.15s, border-color 0.15s;
    }

    .site-nav a:hover,
    .site-nav a[aria-current="page"] {
      color: var(--color-text);
      border-bottom-color: var(--color-text);
    }

    /* Pagination on archive pages keeps the boxed-link look */
    .pagination {
      margin-top: 20px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
    }

    .pagination a {
      padding: 8px 16px;
      text-decoration: none;
      color: var(--color-link);
      background: transparent;
      border: var(--border-subtle) solid var(--color-accent);
      font-size: 0.9em;
      font-weight: 400;
      transition: all 0.2s;
      display: inline-block;
    }

    .pagination a:hover {
      background: var(--color-accent);
      color: var(--color-bg);
    }

    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    .main-content {
      width: 100%;
    }

    /* Hide sidebar */
    .sidebar {
      display: none;
    }

    /* Post Grid */
    .post-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
      margin-top: 30px;
    }

    @media (max-width: 1024px) {
      .post-grid {
        grid-template-columns: 1fr;
      }
    }

    .post-card {
      border: var(--border-subtle) solid var(--color-text-light);
      background: var(--color-paper);
      box-shadow: var(--shadow-subtle) var(--shadow-subtle) 4px rgba(43, 24, 16, 0.1);
      overflow: hidden;
      transition: box-shadow 0.3s;
    }

    .post-card:hover {
      box-shadow: var(--shadow-subtle) var(--shadow-subtle) 8px rgba(43, 24, 16, 0.15);
    }

    .h2ewd-notice {
      background: var(--color-paper, #f5f0e8);
      border: 1px solid var(--color-text-light, #666);
      padding: 1rem 1.5rem;
      margin-bottom: 1.5rem;
      text-align: center;
    }

    .h2ewd-read-button {
      display: inline-block;
      padding: 0.5rem 1.5rem;
      border: 2px solid var(--color-text, #2B1810);
      color: var(--color-text, #2B1810);
      text-decoration: none;
      font-weight: bold;
      margin-top: 0.5rem;
    }

    .h2ewd-read-button:hover {
      background: var(--color-text, #2B1810);
      color: var(--color-paper, #f5f0e8);
    }

    .post-image {
      border-bottom: var(--border-subtle) solid var(--color-text-light);
    }

    .post-image img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      display: block;
      opacity: 0.9;
    }

    .post-header, .post-info, .post-footer {
      padding: 20px 24px;
    }

    .post-info {
      padding: 10px 24px;
    }

    .post-header {
      padding-bottom: 10px;
      background: var(--color-paper);
    }

    .post-title {
      margin: 0 0 8px 0;
      font-size: 1.3em;
      line-height: 1.4;
    }

    .post-title a {
      color: var(--color-link);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s;
    }

    .post-title a:hover {
      color: var(--color-link-hover);
      text-decoration: underline;
    }

    .post-meta {
      color: var(--color-text-light);
      font-size: 0.85em;
      font-style: italic;
    }

    .entry-summary {
      margin: 0;
    }

    .entry-summary p {
      margin: 0;
      color: var(--color-black);
      font-size: 0.9em;
      font-weight: 500;
      line-height: 1.4;
    }

    .post-footer {
      border-top: var(--border-thick) solid var(--color-black);
      background: var(--color-secondary);
      padding: 12px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .post-footer a {
      font-weight: 900;
      text-transform: uppercase;
      font-size: 0.85em;
    }

    .read-more {
      color: var(--color-black);
    }

    /* Sidebar */
    .sidebar {
      position: sticky;
      top: 20px;
      align-self: start;
    }

    .widget {
      background: var(--color-paper);
      border: var(--border-subtle) solid var(--color-text-light);
      box-shadow: var(--shadow-subtle) var(--shadow-subtle) 3px rgba(43, 24, 16, 0.08);
      padding: 24px;
      margin-bottom: 28px;
    }

    .widget h4 {
      margin-top: 0;
      margin-bottom: 16px;
      font-size: 1.1em;
      font-weight: 600;
      color: var(--color-accent);
    }

    .widget input[type="text"],
    .widget input[type="email"],
    .widget input[type="search"] {
      width: 100%;
      padding: 10px 12px;
      border: var(--border-subtle) solid var(--color-text-light);
      background: var(--color-parchment);
      box-sizing: border-box;
      font-family: inherit;
      font-weight: 400;
      font-size: 0.9em;
      color: var(--color-text);
    }

    .widget input[type="text"]:focus,
    .widget input[type="email"]:focus,
    .widget input[type="search"]:focus {
      outline: none;
      border-color: var(--color-accent);
    }

    .widget button {
      width: 100%;
      padding: 10px 16px;
      margin-top: 12px;
      background: var(--color-bg);
      color: var(--color-text);
      border: var(--border-subtle) solid var(--color-text);
      cursor: pointer;
      font-family: inherit;
      font-weight: 400;
      font-size: 0.9em;
      transition: all 0.2s;
    }

    .widget button:hover {
      background: var(--color-paper);
    }

    .social-links {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .social-links li {
      margin-bottom: 8px;
    }

    .social-links a {
      color: var(--color-link);
      text-decoration: none;
      font-weight: 400;
      display: block;
      transition: color 0.2s;
    }

    .social-links a:hover {
      color: var(--color-link-hover);
      text-decoration: underline;
    }

    /* Site footer: a colophon on paper */
    .site-footer {
      border-top: var(--border-subtle) solid var(--color-text);
      margin-top: 60px;
      background: var(--color-paper);
      color: var(--color-text);
    }

    .site-footer-in {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px 44px;
    }

    .site-footer-cols {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 28px 32px;
    }

    .site-footer-h {
      font-family: 'Courier Prime', 'Courier New', Courier, monospace;
      font-size: 0.7em;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-text-light);
      margin: 0 0 12px;
      padding-bottom: 8px;
      border-bottom: var(--border-subtle) solid var(--color-text-light);
      line-height: 1.3;
    }

    .site-footer ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .site-footer li {
      margin: 0 0 6px;
      font-size: 0.95em;
      line-height: 1.5;
    }

    .site-footer a {
      color: var(--color-text);
      text-decoration: none;
      font-weight: 400;
    }

    .site-footer a:hover {
      text-decoration: underline;
    }

    .site-colophon {
      margin: 32px 0 0;
      padding-top: 16px;
      border-top: var(--border-subtle) solid var(--color-text-light);
      font-family: 'Courier Prime', 'Courier New', Courier, monospace;
      font-size: 0.7em;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-light);
      display: flex;
      flex-wrap: wrap;
      gap: 6px 18px;
    }

    .site-colophon a {
      color: var(--color-text-light);
    }

    @media (max-width: 860px) {
      .site-footer-cols {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 480px) {
      .site-footer-cols {
        grid-template-columns: 1fr;
      }
    }

    /* Article Content */
    article img {
      max-width: 100%;
      height: auto;
      border: var(--border-subtle) solid var(--color-text-light);
    }

    article a {
      color: var(--color-link);
      font-weight: 400;
      text-decoration: underline;
    }

    article a:hover {
      color: var(--color-link-hover);
    }

    /* Social Sharing Buttons */
    .social-sharing {
      margin-top: 40px;
      padding-top: 30px;
      border-top: var(--border-thick) solid var(--color-black);
    }

    .social-sharing h3 {
      margin-bottom: 20px;
      font-size: 1.2em;
      text-transform: uppercase;
    }

    .share-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 15px;
    }

    .share-button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      text-decoration: none;
      color: var(--color-text);
      background: var(--color-bg);
      border: var(--border-subtle) solid var(--color-text);
      font-weight: 400;
      font-size: 0.9em;
      transition: all 0.2s;
      cursor: pointer;
    }

    .share-button:hover {
      background: var(--color-paper);
    }

    .share-button.twitter,
    .share-button.facebook,
    .share-button.linkedin,
    .share-button.reddit,
    .share-button.email {
      background: var(--color-bg);
      color: var(--color-text);
    }

    .share-button.twitter:hover,
    .share-button.facebook:hover,
    .share-button.linkedin:hover,
    .share-button.reddit:hover,
    .share-button.email:hover {
      background: var(--color-paper);
    }

    .share-button .icon {
      font-size: 1.1em;
      line-height: 1;
    }

    /* Pagefind Search UI - Neobrutalist Style */
    .pagefind-ui__search-input {
      background: var(--color-white) !important;
      border: var(--border-thick) solid var(--color-black) !important;
      border-radius: 0 !important;
      padding: 15px !important;
      font-family: inherit !important;
      font-weight: 700 !important;
      font-size: 1.1em !important;
      box-shadow: 4px 4px 0 var(--color-black) !important;
    }

    .pagefind-ui__search-input:focus {
      background: var(--color-secondary) !important;
      outline: none !important;
    }

    .pagefind-ui__search-clear {
      background: var(--color-accent) !important;
      color: var(--color-white) !important;
      border: 3px solid var(--color-black) !important;
      border-radius: 0 !important;
      font-weight: 900 !important;
      padding: 8px 12px !important;
    }

    .pagefind-ui__result {
      border: var(--border-thick) solid var(--color-black) !important;
      background: var(--color-white) !important;
      padding: 20px !important;
      margin-bottom: 20px !important;
      box-shadow: 6px 6px 0 var(--color-black) !important;
      border-radius: 0 !important;
    }

    .pagefind-ui__result:hover {
      transform: translate(3px, 3px);
      box-shadow: 3px 3px 0 var(--color-black) !important;
    }

    .pagefind-ui__result-title {
      font-weight: 900 !important;
      color: var(--color-black) !important;
      font-size: 1.3em !important;
    }

    .pagefind-ui__result-link {
      color: var(--color-black) !important;
      text-decoration: none !important;
    }

    .pagefind-ui__result-link:hover {
      color: var(--color-accent) !important;
    }

    .pagefind-ui__result-excerpt {
      color: var(--color-black) !important;
      font-weight: 500 !important;
      line-height: 1.6 !important;
      margin-top: 10px !important;
    }

    .pagefind-ui__result-excerpt mark {
      background: var(--color-secondary) !important;
      color: var(--color-black) !important;
      font-weight: 900 !important;
      padding: 2px 4px !important;
      border: 2px solid var(--color-black) !important;
    }

    .pagefind-ui__button {
      background: var(--color-bg) !important;
      color: var(--color-text) !important;
      border: var(--border-subtle) solid var(--color-text) !important;
      border-radius: 0 !important;
      padding: 10px 16px !important;
      font-weight: 400 !important;
      cursor: pointer !important;
      transition: all 0.2s !important;
    }

    .pagefind-ui__button:hover {
      background: var(--color-paper) !important;
    }

    .pagefind-ui__message {
      background: var(--color-white) !important;
      border: var(--border-thick) solid var(--color-black) !important;
      padding: 20px !important;
      font-weight: 700 !important;
      box-shadow: 6px 6px 0 var(--color-black) !important;
      margin-bottom: 20px !important;
    }

    /* Responsive */
    @media (max-width: 768px) {
      :root {
        --shadow-offset: 4px;
      }

      .container {
        padding: 20px 15px;
      }

      .post-grid {
        gap: 25px;
      }

      .site-header-in {
        padding: 12px 15px;
        justify-content: center;
      }

      .site-nav {
        justify-content: center;
        gap: 4px 16px;
        font-size: 0.7em;
      }

      .pagination {
        gap: 10px;
      }

      .pagination a {
        font-size: 0.8em;
        padding: 8px 14px;
      }

      .share-buttons {
        gap: 8px;
      }

      .share-button {
        font-size: 0.8em;
        padding: 10px 16px;
      }

      .share-button .icon {
        font-size: 1em;
      }
    }

    /* Comments Section */
    .comments-section {
      margin-top: 40px;
      padding-top: 30px;
      border-top: var(--border-thick) solid var(--color-black);
    }

    .comments-section h3 {
      margin-bottom: 20px;
      font-size: 1.2em;
      text-transform: uppercase;
    }

    #disqus_thread {
      background: var(--color-white);
      border: var(--border-thick) solid var(--color-black);
      box-shadow: 6px 6px 0 var(--color-black);
      padding: 30px;
      margin-top: 20px;
    }

    [data-theme="dark"] #disqus_thread {
      background: #2a2a2a;
      border-color: var(--color-black);
    }

    /* Lightbox */
    .lightbox {
      display: none;
      position: fixed;
      z-index: 9999;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.9);
      cursor: zoom-out;
    }

    .lightbox.active {
      display: flex;
      align-items: center;
      justify-content: center;
      animation: fadeIn 0.2s;
    }

    .lightbox img {
      max-width: 95%;
      max-height: 95%;
      object-fit: contain;
      box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
      cursor: default;
    }

    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 30px;
      color: #fff;
      font-size: 40px;
      font-weight: bold;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
      line-height: 1;
      transition: color 0.2s;
    }

    .lightbox-close:hover {
      color: #ccc;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* Make content images clickable */
    .main-content img {
      cursor: zoom-in;
      transition: opacity 0.2s;
    }

    .main-content img:hover {
      opacity: 0.85;
    }
  </style>
</head>
<body>
  <header class="site-header" data-pagefind-ignore>
    <div class="site-header-in">
      <a class="site-brand" href="/" aria-label="{{ site.name }} home">
        {# The thought-bubble hash mark, redrawn as a vector so it stays crisp and follows the theme #}
        <svg class="site-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
          <g fill="var(--color-bg)" stroke="var(--color-text)" stroke-width="2.5">
            <circle cx="22" cy="21" r="12"/>
            <circle cx="38" cy="17" r="12"/>
            <circle cx="50" cy="29" r="10"/>
            <circle cx="44" cy="41" r="10"/>
            <circle cx="28" cy="43" r="11"/>
            <circle cx="14" cy="32" r="10"/>
          </g>
          <g fill="var(--color-bg)">
            <circle cx="22" cy="21" r="12"/>
            <circle cx="38" cy="17" r="12"/>
            <circle cx="50" cy="29" r="10"/>
            <circle cx="44" cy="41" r="10"/>
            <circle cx="28" cy="43" r="11"/>
            <circle cx="14" cy="32" r="10"/>
            <circle cx="32" cy="30" r="15"/>
          </g>
          <g fill="none" stroke="#d21f2b" stroke-width="4.2" stroke-linecap="round">
            <path d="M27.5 19 L25.5 42"/>
            <path d="M38.5 19 L36.5 42"/>
            <path d="M20 25.5 H44"/>
            <path d="M18.5 35.5 H42.5"/>
          </g>
          <g fill="var(--color-bg)" stroke="var(--color-text)" stroke-width="2">
            <circle cx="15" cy="53" r="3.5"/>
            <circle cx="8" cy="59.5" r="2.2"/>
          </g>
        </svg>
        <span class="site-wordmark">Think <em>by</em> Numbers</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/#projects">Projects</a>
        <a href="/posts/"{% if page.url.startsWith('/posts/') %} aria-current="page"{% endif %}>Articles</a>
        <a href="https://manual.warondisease.org" target="_blank" rel="noopener">Book</a>
        <a href="https://open.spotify.com/show/1aX8mw9MmFzyiSBq2RNnu2" target="_blank" rel="noopener">Podcast</a>
        <a href="/search/"{% if page.url == '/search/' %} aria-current="page"{% endif %}>Search</a>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer" id="footer" data-pagefind-ignore>
    <div class="site-footer-in">
      <div class="site-footer-cols">
        <div>
          <p class="site-footer-h">Read</p>
          <ul>
            <li><a href="/posts/">Articles</a></li>
            <li><a href="/empiricism-2/why-think-by-numbers/">Why think by numbers</a></li>
            <li><a href="/search/">Search</a></li>
            <li><a href="/subscribe/">Subscribe</a></li>
            <li><a href="{{ site.feedPath }}">RSS</a></li>
          </ul>
        </div>
        <div>
          <p class="site-footer-h">Listen</p>
          <ul>
            <li><a href="https://open.spotify.com/show/1aX8mw9MmFzyiSBq2RNnu2" target="_blank" rel="noopener">Podcast on Spotify</a></li>
            <li><a href="https://podcasts.apple.com/us/podcast/how-to-end-war-and-disease/id1879755497" target="_blank" rel="noopener">Apple Podcasts</a></li>
            <li><a href="{{ site.podcastFeedPath }}">Podcast feed</a></li>
          </ul>
        </div>
        <div>
          <p class="site-footer-h">The book</p>
          <ul>
            <li><a href="https://manual.warondisease.org" target="_blank" rel="noopener">Read it free online</a></li>
            <li><a href="https://www.amazon.com/dp/B0GPLXFMMT" target="_blank" rel="noopener">Paperback and Kindle</a></li>
            <li><a href="https://warondisease.org/donate?source=think-by-numbers" target="_blank" rel="noopener noreferrer">Support the work</a></li>
          </ul>
        </div>
        <div>
          <p class="site-footer-h">Elsewhere</p>
          <ul>
            <li><a href="/author/mikepsinn/">About the author</a></li>
            <li><a href="mailto:{{ site.author.contactEmail or site.author.email }}">Email</a></li>
            <li><a href="{{ site.author.url }}" target="_blank" rel="noopener">mikesinn.com</a></li>
            <li><a href="{{ site.social.github }}" target="_blank" rel="noopener">GitHub</a></li>
            <li><a href="{{ site.social.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href="{{ site.social.youtube }}" target="_blank" rel="noopener">YouTube</a></li>
            <li><a href="{{ site.social.twitter }}" target="_blank" rel="noopener">X</a></li>
          </ul>
        </div>
      </div>
      <p class="site-colophon">
        <span>&copy; {{ buildYear }} <a href="{{ site.author.url }}">{{ site.author.name }}</a></span>
        <span><a rel="license" href="http://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a></span>
        <span>Set in Crimson Text and Courier Prime</span>
        <span><a href="https://mikesinn.com/privacy-policy" target="_blank" rel="noopener">Privacy</a></span>
      </p>
    </div>
  </footer>

  {# Pagefind only on the search page (homepage just links there) #}
  {%- if page.url == '/search/' %}
  <link href="/_pagefind/pagefind-ui.css" rel="stylesheet">
  <script src="/_pagefind/pagefind-ui.js"></script>
  {%- endif %}

  {# KaTeX only on article pages — skip homepage/listing weight #}
  {%- set isArticle = type == 'post' or (metadata and metadata.type == 'wordpress') %}
  {%- if isArticle %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" onload="renderMathInElement(document.body, {
    delimiters: [
      {left: '$$', right: '$$', display: true},
      {left: '\\[', right: '\\]', display: true},
      {left: '\\(', right: '\\)', display: false}
    ]
  });"></script>
  {%- endif %}

  {# Disqus only on articles (thread markup lives in post.njk) #}
  {%- if site.disqusShortname and isArticle %}
  <script>
    var disqus_config = function () {
      this.page.url = '{{ site.url }}{{ page.url }}';
      this.page.identifier = '{{ page.url }}';
      this.page.title = '{{ title | escape }}';
    };
    (function() {
      var d = document, s = d.createElement('script');
      s.src = 'https://{{ site.disqusShortname }}.disqus.com/embed.js';
      s.setAttribute('data-timestamp', +new Date());
      (d.head || d.body).appendChild(s);
    })();
  </script>
  {%- endif %}

  {# Lightbox for images #}
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" aria-label="Close">&times;</button>
    <img src="" alt="">
  </div>

  <script>
    (function() {
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = lightbox.querySelector('img');
      const closeBtn = lightbox.querySelector('.lightbox-close');

      // Make all content images clickable (exclude post card thumbnails and logo)
      document.querySelectorAll('.main-content img').forEach(img => {
        // Skip if image is already in a link or is the logo
        if (img.closest('a') || img.closest('.logo')) {
          return;
        }

        img.addEventListener('click', function(e) {
          e.preventDefault();
          lightboxImg.src = this.src;
          lightboxImg.alt = this.alt || '';
          lightbox.classList.add('active');
          document.body.style.overflow = 'hidden';
        });
      });

      // Close lightbox when clicking the close button
      closeBtn.addEventListener('click', closeLightbox);

      // Close lightbox when clicking the background
      lightbox.addEventListener('click', function(e) {
        if (e.target === lightbox) {
          closeLightbox();
        }
      });

      // Close lightbox with Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && lightbox.classList.contains('active')) {
          closeLightbox();
        }
      });

      function closeLightbox() {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }
    })();
  </script>
  <script src="https://manual.warondisease.org/assets/js/promotion-bar.js" defer></script>
</body>
</html>
