---
layout: base.njk
description: "Every Think by Numbers article, in curated order. Data-driven analysis of government spending, healthcare, economics, and public policy."
pagination:
  data: collections.gallery
  size: 10
  alias: pagedPosts
permalink: "/posts/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
eleventyComputed:
  title: "{% if pagination.pageNumber > 0 %}Page {{ pagination.pageNumber + 1 }} - {% endif %}Articles"
---

<div class="container" data-pagefind-ignore>
  <div class="main-content">
    {%- if pagination.pageNumber == 0 %}
    <h1 style="margin: 0 0 8px;">Articles</h1>
    <p style="margin: 0 0 24px; color: var(--color-text-light); font-style: italic;">Everything we have published, best first. The <a href="/">front page</a> has the projects and the short version of the argument.</p>
    {%- endif %}

    <form class="home-search" action="/search/" method="get" role="search"
      style="display:flex; gap:10px; margin:0 0 30px;">
      <input type="text" name="q" placeholder="Search articles…" aria-label="Search articles" required
        style="flex:1; min-width:0; padding:12px; font-size:1em; border:3px solid var(--color-text); background:var(--color-bg); color:var(--color-text);">
      <button type="submit"
        style="padding:12px 20px; border:3px solid var(--color-text); background:var(--color-paper); color:var(--color-text); font-family:inherit; font-weight:600; cursor:pointer; white-space:nowrap;">Search</button>
    </form>

    <div class="post-grid">
      {%- for post in pagedPosts %}
      {%- if post.data.title %}
      {% include "post-card.njk" %}
      {%- endif %}
      {%- endfor %}
    </div>

    {%- if pagination.href.previous or pagination.href.next %}
    <nav class="pagination" aria-label="Pagination">
      <div class="pagination-links">
        {%- if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="pagination-link prev">← Previous</a>
        {%- else %}
        <span class="pagination-link prev disabled">← Previous</span>
        {%- endif %}

        <span class="pagination-info">
          Page {{ pagination.pageNumber + 1 }} of {{ pagination.hrefs | length }}
        </span>

        {%- if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="pagination-link next">Next →</a>
        {%- else %}
        <span class="pagination-link next disabled">Next →</span>
        {%- endif %}
      </div>

      <div class="pagination-numbers">
        {%- for pageHref in pagination.hrefs %}
        {%- if loop.index0 == pagination.pageNumber %}
        <span class="page-number current">{{ loop.index }}</span>
        {%- else %}
        <a href="{{ pageHref }}" class="page-number">{{ loop.index }}</a>
        {%- endif %}
        {%- endfor %}
      </div>
    </nav>
    {%- endif %}
  </div>
</div>
